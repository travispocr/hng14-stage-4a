#!/usr/bin/env bash
# =============================================================
# swiftdeploy — declarative deployment CLI (Stage 4B)
# Usage: ./swiftdeploy <init|validate|deploy|promote|status|audit|teardown>
# =============================================================

set -euo pipefail

# ── Colours ───────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; MAGENTA='\033[0;35m'; NC='\033[0m'

info()    { echo -e "${CYAN}[swiftdeploy]${NC} $*"; }
success() { echo -e "${GREEN}[✓]${NC} $*"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*"; }
error()   { echo -e "${RED}[✗]${NC} $*"; }
die()     { error "$*"; exit 1; }
blocked() { echo -e "\n${RED}${BOLD}╔══ POLICY VIOLATION ══════════════════════════════╗${NC}"; \
            echo -e "${RED}${BOLD}║${NC} $*"; \
            echo -e "${RED}${BOLD}╚══════════════════════════════════════════════════╝${NC}\n"; exit 1; }

# ── Paths ─────────────────────────────────────────────────────
MANIFEST="manifest.yaml"
NGINX_TMPL="templates/nginx.conf.tmpl"
COMPOSE_TMPL="templates/docker-compose.yml.tmpl"
NGINX_OUT="nginx.conf"
COMPOSE_OUT="docker-compose.yml"
HISTORY_FILE="history.jsonl"
AUDIT_REPORT="audit_report.md"
OPA_URL="http://localhost:8181"

# ── YAML parser ───────────────────────────────────────────────
yaml_get() {
    local file="$1" key="$2"
    python3 - "$file" "$key" <<'PY'
import sys, re
def load_flat(path):
    result = {}
    current_keys = []
    with open(path) as f:
        for line in f:
            stripped = line.rstrip()
            if not stripped or stripped.lstrip().startswith('#'):
                continue
            indent = len(stripped) - len(stripped.lstrip())
            level = indent // 2
            current_keys = current_keys[:level]
            m = re.match(r'\s*(\w+):\s*(.*)', stripped)
            if m:
                k, v = m.group(1), m.group(2).strip().strip('"').strip("'")
                current_keys.append(k)
                if v:
                    result['.'.join(current_keys)] = v
    return result
flat = load_flat(sys.argv[1])
print(flat.get(sys.argv[2], ''))
PY
}

read_manifest() {
    SERVICE_IMAGE=$(yaml_get "$MANIFEST" "services.image")
    SERVICE_PORT=$(yaml_get "$MANIFEST" "services.port")
    SERVICE_MODE=$(yaml_get "$MANIFEST" "services.mode")
    SERVICE_VERSION=$(yaml_get "$MANIFEST" "services.version")
    SERVICE_RESTART=$(yaml_get "$MANIFEST" "services.restart_policy")
    LOG_VOLUME=$(yaml_get "$MANIFEST" "services.log_volume")
    NGINX_IMAGE=$(yaml_get "$MANIFEST" "nginx.image")
    NGINX_PORT=$(yaml_get "$MANIFEST" "nginx.port")
    PROXY_TIMEOUT=$(yaml_get "$MANIFEST" "nginx.proxy_timeout")
    OPA_PORT=$(yaml_get "$MANIFEST" "opa.port")
    NETWORK_NAME=$(yaml_get "$MANIFEST" "network.name")
    NETWORK_DRIVER=$(yaml_get "$MANIFEST" "network.driver_type")
    CONTACT=$(yaml_get "$MANIFEST" "meta.contact")
    SERVICE_MODE="${SERVICE_MODE:-stable}"
    SERVICE_VERSION="${SERVICE_VERSION:-1.0.0}"
    SERVICE_RESTART="${SERVICE_RESTART:-unless-stopped}"
    LOG_VOLUME="${LOG_VOLUME:-swiftdeploy-logs}"
    PROXY_TIMEOUT="${PROXY_TIMEOUT:-30}"
    CONTACT="${CONTACT:-swiftdeploy@localhost}"
    OPA_PORT="${OPA_PORT:-8181}"
    OPA_URL="http://localhost:${OPA_PORT}"
}

# =============================================================
# OPA helpers
# =============================================================

opa_wait() {
    info "Waiting for OPA to be ready..."
    local elapsed=0
    while [[ $elapsed -lt 60 ]]; do
        if MSYS_NO_PATHCONV=1 docker exec swiftdeploy-opa /opa eval "data" --data /policies > /dev/null 2>&1 &>/dev/null; then
            success "OPA is ready"
            return 0
        fi
        sleep 3; ((elapsed+=3))
    done
    warn "OPA did not become ready in 60s — policy checks will be skipped"
    return 1
}

opa_query() {
    # Usage: opa_query <domain> <input_json>
    # Returns the full decision JSON or empty string on failure
    local domain="$1" input_json="$2"
    local url="http://swiftdeploy-opa:8181/v1/data/swiftdeploy/${domain}/decision"
    # Query OPA via app container which shares the network
    local result
    result=$(docker exec swiftdeploy-app curl -sf -X POST "$url" \
        -H "Content-Type: application/json" \
        -d "{\"input\": ${input_json}}" 2>/dev/null) || true
    echo "$result"
}

opa_check() {
    # Usage: opa_check <domain> <input_json> <context>
    # Prints decision, returns 1 if blocked
    local domain="$1" input_json="$2" context="$3"
    local result allow violations

    echo -e "\n${CYAN}── Policy check: ${domain} ──${NC}"

    result=$(opa_query "$domain" "$input_json")

    if [[ -z "$result" ]]; then
        warn "OPA unavailable for domain '${domain}' — skipping check"
        echo -e "  ${YELLOW}[SKIP]${NC} ${domain}: OPA unreachable"
        return 0
    fi

    allow=$(echo "$result" | python3 -c "import sys,json; d=json.load(sys.stdin); r=d.get('result',{}); a=r.get('allow',False); print(str(a).lower())" 2>/dev/null || echo "false")
    violations=$(echo "$result" | python3 -c "
import sys,json
d=json.load(sys.stdin)
r=d.get('result',{})
vs=r.get('violations',[])
for v in vs: print('  •', v)
" 2>/dev/null || true)

    if [[ "$allow" == "true" ]]; then
        echo -e "  ${GREEN}[PASS]${NC} ${domain}: all checks passed"
        return 0
    else
        echo -e "  ${RED}[FAIL]${NC} ${domain}: policy violated"
        echo -e "$violations"
        return 1
    fi
}

# =============================================================
# Host stats collector
# =============================================================

get_host_stats() {
    python3 - <<'PY'
import json, os, time, shutil

# Disk free in GB (root partition)
total, used, free = shutil.disk_usage("/")
disk_free_gb = free / (1024**3)

# CPU load (1-min average)
try:
    with open("/proc/loadavg") as f:
        cpu_load = float(f.read().split()[0])
except:
    cpu_load = 0.0

# Memory free percent
try:
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mem[k.strip()] = int(v.strip().split()[0])
    mem_total = mem.get("MemTotal", 1)
    mem_avail = mem.get("MemAvailable", mem_total)
    mem_free_percent = (mem_avail / mem_total) * 100
except:
    mem_free_percent = 50.0

print(json.dumps({
    "disk_free_gb": round(disk_free_gb, 2),
    "cpu_load": round(cpu_load, 3),
    "mem_free_percent": round(mem_free_percent, 2),
    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
}))
PY
}

# =============================================================
# Metrics scraper
# =============================================================

scrape_metrics() {
    local port="$1"
    curl -sf "http://localhost:${port}/metrics" 2>/dev/null || echo ""
}

parse_metrics() {
    # Usage: parse_metrics <raw_metrics>
    # Outputs JSON with error_rate_percent, p99_latency_ms, chaos_active
    local raw="$1"
    python3 - "$raw" <<'PY'
import sys, json, re, time

raw = sys.argv[1]
lines = raw.strip().split("\n") if raw.strip() else []

total_requests = 0
error_requests = 0
chaos_active = 0
buckets = {}
inf_count = 0
duration_sum = 0.0
duration_count = 0

for line in lines:
    if line.startswith("#") or not line.strip():
        continue

    # http_requests_total
    m = re.match(r'http_requests_total\{.*?status_code="(\d+)".*?\}\s+(\d+)', line)
    if m:
        code, count = int(m.group(1)), int(m.group(2))
        total_requests += count
        if code >= 500:
            error_requests += count

    # chaos_active
    m = re.match(r'chaos_active\s+(\d+)', line)
    if m:
        chaos_active = int(m.group(1))

    # histogram buckets
    m = re.match(r'http_request_duration_seconds_bucket\{.*?le="([^"]+)".*?\}\s+(\d+)', line)
    if m:
        le, count = m.group(1), int(m.group(2))
        if le == "+Inf":
            inf_count = count
        else:
            buckets[float(le)] = count

    # sum and count
    m = re.match(r'http_request_duration_seconds_sum\{.*?\}\s+([\d.]+)', line)
    if m:
        duration_sum += float(m.group(1))

    m = re.match(r'http_request_duration_seconds_count\{.*?\}\s+(\d+)', line)
    if m:
        duration_count += int(m.group(1))

error_rate = (error_requests / total_requests * 100) if total_requests > 0 else 0.0

# P99 from histogram
p99_latency_ms = 0.0
if inf_count > 0:
    target = inf_count * 0.99
    sorted_buckets = sorted(buckets.items())
    for le, count in sorted_buckets:
        if count >= target:
            p99_latency_ms = le * 1000
            break
    else:
        p99_latency_ms = sorted_buckets[-1][0] * 1000 if sorted_buckets else 0.0

print(json.dumps({
    "error_rate_percent": round(error_rate, 4),
    "p99_latency_ms": round(p99_latency_ms, 2),
    "chaos_active": chaos_active,
    "total_requests": total_requests,
    "error_requests": error_requests,
    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
}))
PY
}

# =============================================================
# History logger
# =============================================================

log_history() {
    local event_type="$1" data="$2"
    local ts
    ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    echo "{\"timestamp\":\"${ts}\",\"event\":\"${event_type}\",\"data\":${data}}" >> "$HISTORY_FILE"
}

# =============================================================
# SUBCOMMAND: init
# =============================================================
cmd_init() {
    info "Reading manifest.yaml..."
    read_manifest

    info "Generating nginx.conf from template..."
    sed \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{PROXY_TIMEOUT}}|${PROXY_TIMEOUT}|g" \
        -e "s|{{CONTACT}}|${CONTACT}|g" \
        "$NGINX_TMPL" > "$NGINX_OUT"
    success "nginx.conf generated"

    info "Generating docker-compose.yml from template..."
    sed \
        -e "s|{{SERVICE_IMAGE}}|${SERVICE_IMAGE}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{MODE}}|${SERVICE_MODE}|g" \
        -e "s|{{APP_VERSION}}|${SERVICE_VERSION}|g" \
        -e "s|{{RESTART_POLICY}}|${SERVICE_RESTART}|g" \
        -e "s|{{LOG_VOLUME}}|${LOG_VOLUME}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        "$COMPOSE_TMPL" > "$COMPOSE_OUT"
    success "docker-compose.yml generated"

    # Ensure policies dir exists
    mkdir -p policies
    success "policies/ directory confirmed"

    echo ""
    success "init complete — configs ready to deploy"
}

# =============================================================
# SUBCOMMAND: validate
# =============================================================
cmd_validate() {
    echo -e "\n${BOLD}SwiftDeploy Pre-flight Validation${NC}"
    echo "────────────────────────────────────"
    local failed=0

    printf "  [1] manifest.yaml exists and is valid YAML ... "
    if [[ ! -f "$MANIFEST" ]]; then
        echo -e "${RED}FAIL${NC} (file not found)"; ((failed++))
    else
        if python3 -c "import yaml; yaml.safe_load(open('$MANIFEST'))" 2>/dev/null; then
            echo -e "${GREEN}PASS${NC}"
        else
            echo -e "${RED}FAIL${NC} (invalid YAML)"; ((failed++))
        fi
    fi

    printf "  [2] All required fields present and non-empty ... "
    read_manifest 2>/dev/null || true
    local missing=()
    [[ -z "$SERVICE_IMAGE" ]]  && missing+=("services.image")
    [[ -z "$SERVICE_PORT" ]]   && missing+=("services.port")
    [[ -z "$NGINX_IMAGE" ]]    && missing+=("nginx.image")
    [[ -z "$NGINX_PORT" ]]     && missing+=("nginx.port")
    [[ -z "$NETWORK_NAME" ]]   && missing+=("network.name")
    [[ -z "$NETWORK_DRIVER" ]] && missing+=("network.driver_type")
    if [[ ${#missing[@]} -eq 0 ]]; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC} (missing: ${missing[*]})"; ((failed++))
    fi

    printf "  [3] Docker image '${SERVICE_IMAGE}' exists locally ... "
    if docker image inspect "$SERVICE_IMAGE" &>/dev/null; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC} (run: docker build -t ${SERVICE_IMAGE} .)"; ((failed++))
    fi

    printf "  [4] Nginx port ${NGINX_PORT} is free on host ... "
    if ss -tlnp 2>/dev/null | grep -q ":${NGINX_PORT} " || \
       netstat -tlnp 2>/dev/null | grep -q ":${NGINX_PORT} "; then
        echo -e "${RED}FAIL${NC} (port ${NGINX_PORT} already in use)"; ((failed++))
    else
        echo -e "${GREEN}PASS${NC}"
    fi

    printf "  [5] nginx.conf syntax is valid ... "
    if [[ ! -f "$NGINX_OUT" ]]; then
        echo -e "${YELLOW}SKIP${NC} (run: ./swiftdeploy init first)"
    else
        if docker run --rm -v "$(pwd)/${NGINX_OUT}:/etc/nginx/conf.d/default.conf:ro" \
            nginx:latest nginx -t 2>/dev/null; then
            echo -e "${GREEN}PASS${NC}"
        else
            echo -e "${RED}FAIL${NC} (nginx config has syntax errors)"; ((failed++))
        fi
    fi

    printf "  [6] policies/ directory has .rego files ... "
    if ls policies/*.rego &>/dev/null 2>&1; then
        local count
        count=$(ls policies/*.rego | wc -l)
        echo -e "${GREEN}PASS${NC} (${count} policy files found)"
    else
        echo -e "${RED}FAIL${NC} (no .rego files in policies/)"; ((failed++))
    fi

    echo "────────────────────────────────────"
    if [[ $failed -eq 0 ]]; then
        echo -e "${GREEN}All checks passed. Ready to deploy.${NC}"
    else
        echo -e "${RED}${failed} check(s) failed.${NC}"
        exit 1
    fi
}

# =============================================================
# SUBCOMMAND: deploy
# =============================================================
cmd_deploy() {
    info "Running init..."
    cmd_init

    read_manifest

    # ── Pre-deploy OPA check ──────────────────────────────────
    info "Running pre-deploy policy checks..."
    local host_stats blocked=false

    # Start stack first so OPA is available, then check
    info "Bringing up the stack..."
    docker compose -f "$COMPOSE_OUT" up -d --build

    # Wait for OPA
    if opa_wait; then
        host_stats=$(get_host_stats)
        if ! opa_check "infrastructure" "$host_stats" "pre-deploy"; then
            blocked=true
        fi
        if $blocked; then
            error "Deployment blocked by policy. Tearing down..."
            docker compose -f "$COMPOSE_OUT" down -v --remove-orphans 2>/dev/null || true
            log_history "deploy_blocked" "$host_stats"
            blocked "Deployment blocked by infrastructure policy. Fix violations and retry."
        fi
        log_history "policy_pass" "{\"domain\":\"infrastructure\",\"context\":\"pre-deploy\"}"
    fi

    # Wait for app health
    info "Waiting for health checks (timeout: 60s)..."
    local elapsed=0
    while [[ $elapsed -lt 60 ]]; do
        local status
        status=$(docker inspect --format='{{.State.Health.Status}}' swiftdeploy-app 2>/dev/null || echo "starting")
        if [[ "$status" == "healthy" ]]; then
            success "Service is healthy!"
            echo ""
            curl -s "http://localhost:${NGINX_PORT}/healthz" | python3 -m json.tool 2>/dev/null || true
            echo ""
            log_history "deploy_success" "{\"mode\":\"${SERVICE_MODE}\",\"version\":\"${SERVICE_VERSION}\"}"
            success "Stack is live at http://localhost:${NGINX_PORT}"
            return 0
        fi
        echo -e "  ${YELLOW}[${elapsed}s]${NC} Status: ${status} — waiting..."
        sleep 5; ((elapsed+=5))
    done

    error "Health check timed out after 60s"
    docker compose -f "$COMPOSE_OUT" logs --tail=20
    exit 1
}

# =============================================================
# SUBCOMMAND: promote
# =============================================================
cmd_promote() {
    local target_mode="${1:-}"
    [[ "$target_mode" != "canary" && "$target_mode" != "stable" ]] && \
        die "Usage: ./swiftdeploy promote [canary|stable]"

    read_manifest
    local current_mode="$SERVICE_MODE"
    [[ "$current_mode" == "$target_mode" ]] && { warn "Already in ${target_mode} mode."; exit 0; }

    # ── Pre-promote OPA check (canary→stable only needs canary check) ──
    if [[ "$target_mode" == "stable" ]]; then
        info "Running pre-promote canary safety checks..."
        local raw_metrics metrics_json

        if opa_wait 2>/dev/null; then
            raw_metrics=$(scrape_metrics "$NGINX_PORT")
            if [[ -z "$raw_metrics" ]]; then
                warn "Could not scrape metrics — skipping canary policy check"
            else
                metrics_json=$(parse_metrics "$raw_metrics")
                if ! opa_check "canary" "$metrics_json" "pre-promote"; then
                    log_history "promote_blocked" "$metrics_json"
                    blocked "Promotion to stable blocked by canary safety policy. Recover chaos or wait for metrics to improve."
                fi
                log_history "policy_pass" "{\"domain\":\"canary\",\"context\":\"pre-promote\"}"
            fi
        fi
    fi

    info "Promoting from '${current_mode}' → '${target_mode}'..."

    sed -i "s|^  mode: .*|  mode: ${target_mode}|" "$MANIFEST"
    success "manifest.yaml updated (mode: ${target_mode})"

    read_manifest
    sed \
        -e "s|{{SERVICE_IMAGE}}|${SERVICE_IMAGE}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{MODE}}|${SERVICE_MODE}|g" \
        -e "s|{{APP_VERSION}}|${SERVICE_VERSION}|g" \
        -e "s|{{RESTART_POLICY}}|${SERVICE_RESTART}|g" \
        -e "s|{{LOG_VOLUME}}|${LOG_VOLUME}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        "$COMPOSE_TMPL" > "$COMPOSE_OUT"
    success "docker-compose.yml regenerated"

    docker compose -f "$COMPOSE_OUT" up -d --no-deps app
    success "App container restarted"

    local elapsed=0
    while [[ $elapsed -lt 60 ]]; do
        local status
        status=$(docker inspect --format='{{.State.Health.Status}}' swiftdeploy-app 2>/dev/null || echo "starting")
        [[ "$status" == "healthy" ]] && break
        sleep 3; ((elapsed+=3))
    done

    info "Confirming mode via /healthz..."
    local response confirmed_mode
    response=$(curl -s "http://localhost:${NGINX_PORT}/healthz")
    echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"
    confirmed_mode=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('mode','unknown'))" 2>/dev/null || echo "unknown")

    if [[ "$confirmed_mode" == "$target_mode" ]]; then
        log_history "mode_change" "{\"from\":\"${current_mode}\",\"to\":\"${target_mode}\"}"
        success "Promotion complete! Mode is now: ${target_mode}"
    else
        error "Mode mismatch — expected '${target_mode}', got '${confirmed_mode}'"
        exit 1
    fi

    [[ "$target_mode" == "canary" ]] && {
        info "Verifying X-Mode header..."
        curl -sI "http://localhost:${NGINX_PORT}/" | grep -i "x-mode" || warn "X-Mode header not present"
    }
}

# =============================================================
# SUBCOMMAND: status
# =============================================================
cmd_status() {
    read_manifest
    info "Starting live status dashboard (Ctrl+C to stop)..."
    echo ""

    python3 - "$NGINX_PORT" "$OPA_URL" "$HISTORY_FILE" <<'PY'
import sys, time, json, re, urllib.request, urllib.error, os

nginx_port = sys.argv[1]
opa_url    = sys.argv[2]
hist_file  = sys.argv[3]

CYAN='\033[0;36m'; GREEN='\033[0;32m'; RED='\033[0;31m'
YELLOW='\033[1;33m'; BOLD='\033[1m'; NC='\033[0m'; MAGENTA='\033[0;35m'

def fetch(url):
    try:
        with urllib.request.urlopen(url, timeout=3) as r:
            return r.read().decode()
    except:
        return ""

def parse_metrics(raw):
    total, errors, chaos = 0, 0, 0
    buckets, inf_c, dur_sum, dur_count = {}, 0, 0.0, 0
    for line in raw.strip().split("\n"):
        if line.startswith("#") or not line.strip():
            continue
        m = re.match(r'http_requests_total\{.*?status_code="(\d+)".*?\}\s+(\d+)', line)
        if m:
            code, cnt = int(m.group(1)), int(m.group(2))
            total += cnt
            if code >= 500: errors += cnt
        m = re.match(r'chaos_active\s+(\d+)', line)
        if m: chaos = int(m.group(1))
        m = re.match(r'http_request_duration_seconds_bucket\{.*?le="([^"]+)".*?\}\s+(\d+)', line)
        if m:
            le, c = m.group(1), int(m.group(2))
            if le == "+Inf": inf_c = c
            else: buckets[float(le)] = c
        m = re.match(r'http_request_duration_seconds_sum\{.*?\}\s+([\d.]+)', line)
        if m: dur_sum += float(m.group(1))
        m = re.match(r'http_request_duration_seconds_count\{.*?\}\s+(\d+)', line)
        if m: dur_count += int(m.group(1))
    err_rate = (errors/total*100) if total>0 else 0.0
    p99 = 0.0
    if inf_c > 0:
        target = inf_c * 0.99
        for le, c in sorted(buckets.items()):
            if c >= target: p99 = le*1000; break
        else: p99 = (max(buckets.keys())*1000) if buckets else 0.0
    avg_ms = (dur_sum/dur_count*1000) if dur_count>0 else 0.0
    return total, errors, err_rate, p99, avg_ms, chaos

def opa_compliance(opa_url):
    domains = ["infrastructure","canary"]
    results = []
    for d in domains:
        url = f"http://swiftdeploy-opa:8181/v1/data/swiftdeploy/{d}/decision"
        try:
            import subprocess
            import time as _time
            ts = _time.strftime("%Y-%m-%dT%H:%M:%SZ", _time.gmtime())
            if d == "infrastructure":
                body = f'{{"input":{{"disk_free_gb":50,"cpu_load":0.1,"mem_free_percent":50,"timestamp":"{ts}"}}}}'
            else:
                body = f'{{"input":{{"error_rate_percent":0,"p99_latency_ms":0,"chaos_active":0,"timestamp":"{ts}"}}}}'
            cmd = ["docker", "exec", "swiftdeploy-app", "curl", "-sf", "-X", "POST", url,
                   "-H", "Content-Type: application/json", "-d", body]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
            data = json.loads(r.stdout)
            allow = data.get("result",{}).get("allow", False)
            vs    = data.get("result",{}).get("violations",[])
            results.append((d, allow, vs))
        except:
            results.append((d, None, []))
    return results

prev_total = 0
prev_time  = time.time()

try:
    while True:
        print("\033[2J\033[H", end="", flush=True)
        now = time.time()
        ts  = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

        raw = fetch(f"http://localhost:{nginx_port}/metrics")
        total, errors, err_rate, p99, avg_ms, chaos = parse_metrics(raw) if raw else (0,0,0,0,0,0)

        dt = now - prev_time
        rps = (total - prev_total) / dt if dt > 0 else 0
        prev_total = total; prev_time = now

        chaos_str = {0:"none", 1:"slow", 2:"error"}.get(chaos, "?")
        chaos_col = GREEN if chaos==0 else RED

        print(f"{BOLD}{CYAN}SwiftDeploy Status Dashboard{NC}  {YELLOW}{ts}{NC}")
        print("─" * 55)
        print(f"  {BOLD}Throughput{NC}   {rps:.1f} req/s   {BOLD}Total{NC} {total}")
        print(f"  {BOLD}Error rate{NC}   {RED if err_rate>1 else GREEN}{err_rate:.2f}%{NC}")
        print(f"  {BOLD}P99 latency{NC}  {RED if p99>500 else GREEN}{p99:.0f}ms{NC}   {BOLD}Avg{NC} {avg_ms:.0f}ms")
        print(f"  {BOLD}Chaos{NC}        {chaos_col}{chaos_str}{NC}")
        print()

        print(f"  {BOLD}Policy Compliance{NC}")
        compliance = opa_compliance(opa_url)
        for domain, allow, vs in compliance:
            if allow is None:
                print(f"    {YELLOW}[?]{NC}  {domain}: OPA unreachable")
            elif allow:
                print(f"    {GREEN}[✓]{NC}  {domain}: passing")
            else:
                print(f"    {RED}[✗]{NC}  {domain}: FAILING")
                for v in vs:
                    print(f"         • {v}")
        print()
        print(f"  {BOLD}History log{NC}  {hist_file}")
        print("─" * 55)
        print(f"  Refreshing every 5s — Ctrl+C to exit")

        # Append to history
        entry = json.dumps({
            "timestamp": ts,
            "event": "status_scrape",
            "data": {
                "rps": round(rps,2),
                "total_requests": total,
                "error_requests": errors,
                "error_rate_percent": round(err_rate,4),
                "p99_latency_ms": round(p99,2),
                "avg_latency_ms": round(avg_ms,2),
                "chaos_active": chaos
            }
        })
        with open(hist_file, "a") as f:
            f.write(entry + "\n")

        time.sleep(5)
except KeyboardInterrupt:
    print(f"\n{CYAN}[swiftdeploy]{NC} Status dashboard stopped.")
PY
}

