#!/usr/bin/env bash
# =============================================================
# swiftdeploy — declarative deployment CLI
# Usage: ./swiftdeploy <init|validate|deploy|promote|teardown>
# =============================================================

set -euo pipefail

# ── Colours ───────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

info()    { echo -e "${CYAN}[swiftdeploy]${NC} $*"; }
success() { echo -e "${GREEN}[✓]${NC} $*"; }
warn()    { echo -e "${YELLOW}[!]${NC} $*"; }
error()   { echo -e "${RED}[✗]${NC} $*"; }
die()     { error "$*"; exit 1; }

# ── Paths ─────────────────────────────────────────────────────
MANIFEST="manifest.yaml"
NGINX_TMPL="templates/nginx.conf.tmpl"
COMPOSE_TMPL="templates/docker-compose.yml.tmpl"
NGINX_OUT="nginx.conf"
COMPOSE_OUT="docker-compose.yml"

# ── YAML parser (pure bash — no external deps) ────────────────
yaml_get() {
    # Usage: yaml_get <file> <key.subkey>
    local file="$1" key="$2"
    python3 - "$file" "$key" <<'PY'
import sys, re

def load_flat(path):
    result = {}
    current_keys = []
    with open(path) as f:
        for line in f:
            stripped = line.rstrip()
            if not stripped or stripped.lstrip().startswith('#'):
                continue
            indent = len(stripped) - len(stripped.lstrip())
            level = indent // 2
            current_keys = current_keys[:level]
            m = re.match(r'\s*(\w+):\s*(.*)', stripped)
            if m:
                k, v = m.group(1), m.group(2).strip().strip('"').strip("'")
                current_keys.append(k)
                if v:
                    result['.'.join(current_keys)] = v
    return result

flat = load_flat(sys.argv[1])
print(flat.get(sys.argv[2], ''))
PY
}

# ── Read manifest fields ──────────────────────────────────────
read_manifest() {
    SERVICE_IMAGE=$(yaml_get "$MANIFEST" "services.image")
    SERVICE_PORT=$(yaml_get "$MANIFEST" "services.port")
    SERVICE_MODE=$(yaml_get "$MANIFEST" "services.mode")
    SERVICE_VERSION=$(yaml_get "$MANIFEST" "services.version")
    SERVICE_RESTART=$(yaml_get "$MANIFEST" "services.restart_policy")
    LOG_VOLUME=$(yaml_get "$MANIFEST" "services.log_volume")
    NGINX_IMAGE=$(yaml_get "$MANIFEST" "nginx.image")
    NGINX_PORT=$(yaml_get "$MANIFEST" "nginx.port")
    PROXY_TIMEOUT=$(yaml_get "$MANIFEST" "nginx.proxy_timeout")
    NETWORK_NAME=$(yaml_get "$MANIFEST" "network.name")
    NETWORK_DRIVER=$(yaml_get "$MANIFEST" "network.driver_type")
    CONTACT=$(yaml_get "$MANIFEST" "meta.contact")

    # Defaults
    SERVICE_MODE="${SERVICE_MODE:-stable}"
    SERVICE_VERSION="${SERVICE_VERSION:-1.0.0}"
    SERVICE_RESTART="${SERVICE_RESTART:-unless-stopped}"
    LOG_VOLUME="${LOG_VOLUME:-swiftdeploy-logs}"
    PROXY_TIMEOUT="${PROXY_TIMEOUT:-30}"
    CONTACT="${CONTACT:-swiftdeploy@localhost}"
}

# =============================================================
# SUBCOMMAND: init
# =============================================================
cmd_init() {
    info "Reading manifest.yaml..."
    read_manifest

    info "Generating nginx.conf from template..."
    sed \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{PROXY_TIMEOUT}}|${PROXY_TIMEOUT}|g" \
        -e "s|{{CONTACT}}|${CONTACT}|g" \
        "$NGINX_TMPL" > "$NGINX_OUT"
    success "nginx.conf generated"

    info "Generating docker-compose.yml from template..."
    sed \
        -e "s|{{SERVICE_IMAGE}}|${SERVICE_IMAGE}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{MODE}}|${SERVICE_MODE}|g" \
        -e "s|{{APP_VERSION}}|${SERVICE_VERSION}|g" \
        -e "s|{{RESTART_POLICY}}|${SERVICE_RESTART}|g" \
        -e "s|{{LOG_VOLUME}}|${LOG_VOLUME}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        "$COMPOSE_TMPL" > "$COMPOSE_OUT"
    success "docker-compose.yml generated"

    echo ""
    success "init complete — configs ready to deploy"
}

# =============================================================
# SUBCOMMAND: validate
# =============================================================
cmd_validate() {
    echo -e "\n${BOLD}SwiftDeploy Pre-flight Validation${NC}"
    echo "────────────────────────────────────"
    local failed=0

    # Check 1 — manifest.yaml exists and is valid YAML
    printf "  [1] manifest.yaml exists and is valid YAML ... "
    if [[ ! -f "$MANIFEST" ]]; then
        echo -e "${RED}FAIL${NC} (file not found)"
        ((failed++))
    else
        if python3 -c "import yaml; yaml.safe_load(open('$MANIFEST'))" 2>/dev/null; then
            echo -e "${GREEN}PASS${NC}"
        else
            echo -e "${RED}FAIL${NC} (invalid YAML)"
            ((failed++))
        fi
    fi

    # Check 2 — required fields present and non-empty
    printf "  [2] All required fields present and non-empty ... "
    read_manifest 2>/dev/null || true
    local missing=()
    [[ -z "$SERVICE_IMAGE" ]]  && missing+=("services.image")
    [[ -z "$SERVICE_PORT" ]]   && missing+=("services.port")
    [[ -z "$NGINX_IMAGE" ]]    && missing+=("nginx.image")
    [[ -z "$NGINX_PORT" ]]     && missing+=("nginx.port")
    [[ -z "$NETWORK_NAME" ]]   && missing+=("network.name")
    [[ -z "$NETWORK_DRIVER" ]] && missing+=("network.driver_type")
    if [[ ${#missing[@]} -eq 0 ]]; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC} (missing: ${missing[*]})"
        ((failed++))
    fi

    # Check 3 — Docker image exists locally
    printf "  [3] Docker image '${SERVICE_IMAGE}' exists locally ... "
    if docker image inspect "$SERVICE_IMAGE" &>/dev/null; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC} (image not found — run: docker build -t ${SERVICE_IMAGE} .)"
        ((failed++))
    fi

    # Check 4 — Nginx port not already bound
    printf "  [4] Nginx port ${NGINX_PORT} is free on host ... "
    if ss -tlnp 2>/dev/null | grep -q ":${NGINX_PORT} " || \
       netstat -tlnp 2>/dev/null | grep -q ":${NGINX_PORT} "; then
        echo -e "${RED}FAIL${NC} (port ${NGINX_PORT} already in use)"
        ((failed++))
    else
        echo -e "${GREEN}PASS${NC}"
    fi

    # Check 5 — nginx.conf syntax valid
    printf "  [5] nginx.conf syntax is valid ... "
    if [[ ! -f "$NGINX_OUT" ]]; then
        echo -e "${YELLOW}SKIP${NC} (nginx.conf not generated yet — run: ./swiftdeploy init)"
    else
        if docker run --rm -v "$(pwd)/${NGINX_OUT}:/etc/nginx/conf.d/default.conf:ro" \
            nginx:latest nginx -t 2>/dev/null; then
            echo -e "${GREEN}PASS${NC}"
        else
            echo -e "${RED}FAIL${NC} (nginx config has syntax errors)"
            ((failed++))
        fi
    fi

    echo "────────────────────────────────────"
    if [[ $failed -eq 0 ]]; then
        echo -e "${GREEN}All checks passed. Ready to deploy.${NC}"
    else
        echo -e "${RED}${failed} check(s) failed. Fix issues before deploying.${NC}"
        exit 1
    fi
}

# =============================================================
# SUBCOMMAND: deploy
# =============================================================
cmd_deploy() {
    info "Running init..."
    cmd_init

    info "Bringing up the stack..."
    docker compose -f "$COMPOSE_OUT" up -d --build

    info "Waiting for health checks (timeout: 60s)..."
    read_manifest
    local elapsed=0
    local interval=5
    local timeout=60

    while [[ $elapsed -lt $timeout ]]; do
        local status
        status=$(docker inspect --format='{{.State.Health.Status}}' swiftdeploy-app 2>/dev/null || echo "starting")

        if [[ "$status" == "healthy" ]]; then
            success "Service is healthy!"
            echo ""
            # Show /healthz response
            local healthz_url="http://localhost:${NGINX_PORT}/healthz"
            info "Health check response from ${healthz_url}:"
            curl -s "$healthz_url" | python3 -m json.tool 2>/dev/null || true
            echo ""
            success "Stack is live at http://localhost:${NGINX_PORT}"
            return 0
        fi

        echo -e "  ${YELLOW}[${elapsed}s]${NC} Status: ${status} — waiting..."
        sleep $interval
        ((elapsed += interval))
    done

    error "Health check timed out after ${timeout}s"
    docker compose -f "$COMPOSE_OUT" logs --tail=20
    exit 1
}

# =============================================================
# SUBCOMMAND: promote
# =============================================================
cmd_promote() {
    local target_mode="${1:-}"
    [[ "$target_mode" != "canary" && "$target_mode" != "stable" ]] && \
        die "Usage: ./swiftdeploy promote [canary|stable]"

    read_manifest
    local current_mode="$SERVICE_MODE"

    if [[ "$current_mode" == "$target_mode" ]]; then
        warn "Already in ${target_mode} mode. Nothing to do."
        exit 0
    fi

    info "Promoting from '${current_mode}' → '${target_mode}'..."

    # 1. Update manifest.yaml in-place
    info "Updating manifest.yaml..."
    sed -i "s|^  mode: .*|  mode: ${target_mode}|" "$MANIFEST"
    success "manifest.yaml updated (mode: ${target_mode})"

    # 2. Regenerate docker-compose.yml with new MODE
    info "Regenerating docker-compose.yml..."
    read_manifest   # re-read so SERVICE_MODE is updated
    sed \
        -e "s|{{SERVICE_IMAGE}}|${SERVICE_IMAGE}|g" \
        -e "s|{{SERVICE_PORT}}|${SERVICE_PORT}|g" \
        -e "s|{{MODE}}|${SERVICE_MODE}|g" \
        -e "s|{{APP_VERSION}}|${SERVICE_VERSION}|g" \
        -e "s|{{RESTART_POLICY}}|${SERVICE_RESTART}|g" \
        -e "s|{{LOG_VOLUME}}|${LOG_VOLUME}|g" \
        -e "s|{{NGINX_IMAGE}}|${NGINX_IMAGE}|g" \
        -e "s|{{NGINX_PORT}}|${NGINX_PORT}|g" \
        -e "s|{{NETWORK_NAME}}|${NETWORK_NAME}|g" \
        -e "s|{{NETWORK_DRIVER}}|${NETWORK_DRIVER}|g" \
        "$COMPOSE_TMPL" > "$COMPOSE_OUT"
    success "docker-compose.yml regenerated"

    # 3. Restart ONLY the app container (not nginx)
    info "Restarting app container only..."
    docker compose -f "$COMPOSE_OUT" up -d --no-deps app
    success "App container restarted"

    # 4. Confirm new mode via /healthz
    info "Waiting for service to come back healthy..."
    local elapsed=0
    while [[ $elapsed -lt 60 ]]; do
        local status
        status=$(docker inspect --format='{{.State.Health.Status}}' swiftdeploy-app 2>/dev/null || echo "starting")
        if [[ "$status" == "healthy" ]]; then
            break
        fi
        sleep 3
        ((elapsed += 3))
    done

    info "Confirming mode via /healthz..."
    local response
    response=$(curl -s "http://localhost:${NGINX_PORT}/healthz")
    echo "$response" | python3 -m json.tool 2>/dev/null || echo "$response"

    local confirmed_mode
    confirmed_mode=$(echo "$response" | python3 -c "import sys,json; print(json.load(sys.stdin).get('mode','unknown'))" 2>/dev/null || echo "unknown")

    if [[ "$confirmed_mode" == "$target_mode" ]]; then
        echo ""
        success "Promotion complete! Mode is now: ${target_mode}"
    else
        error "Mode mismatch — expected '${target_mode}', got '${confirmed_mode}'"
        exit 1
    fi

    # Show X-Mode header for canary
    if [[ "$target_mode" == "canary" ]]; then
        info "Verifying X-Mode header..."
        curl -sI "http://localhost:${NGINX_PORT}/" | grep -i "x-mode" || warn "X-Mode header not present"
    fi
}

# =============================================================
# SUBCOMMAND: teardown
# =============================================================
cmd_teardown() {
    local clean=false
    [[ "${1:-}" == "--clean" ]] && clean=true

    info "Tearing down the stack..."

    if [[ -f "$COMPOSE_OUT" ]]; then
        docker compose -f "$COMPOSE_OUT" down -v --remove-orphans 2>/dev/null || true
        success "Containers, networks, and volumes removed"
    else
        warn "docker-compose.yml not found — attempting direct cleanup..."
        docker rm -f swiftdeploy-app swiftdeploy-nginx 2>/dev/null || true
        docker network rm swiftdeploy-net 2>/dev/null || true
    fi

    if $clean; then
        info "Removing generated config files (--clean)..."
        rm -f "$NGINX_OUT" "$COMPOSE_OUT"
        success "Generated configs deleted"
    fi

    success "Teardown complete"
}

# =============================================================
# SUBCOMMAND: help
# =============================================================
cmd_help() {
    echo -e "${BOLD}swiftdeploy${NC} — declarative deployment CLI"
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  ./swiftdeploy <subcommand> [options]"
    echo ""
    echo -e "${BOLD}Subcommands:${NC}"
    echo "  init                 Generate nginx.conf + docker-compose.yml from manifest"
    echo "  validate             Run 5 pre-flight checks"
    echo "  deploy               Run init, start the stack, wait for health checks"
    echo "  promote [canary|stable]  Switch deployment mode with rolling restart"
    echo "  teardown [--clean]   Remove containers/networks/volumes; --clean also removes configs"
    echo "  help                 Show this message"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  ./swiftdeploy deploy"
    echo "  ./swiftdeploy promote canary"
    echo "  ./swiftdeploy promote stable"
    echo "  ./swiftdeploy teardown --clean"
}

# =============================================================
# Entrypoint
# =============================================================
SUBCOMMAND="${1:-help}"
shift || true

case "$SUBCOMMAND" in
    init)       cmd_init ;;
    validate)   cmd_validate ;;
    deploy)     cmd_deploy ;;
    promote)    cmd_promote "${1:-}" ;;
    teardown)   cmd_teardown "${1:-}" ;;
    help|--help|-h) cmd_help ;;
    *)          die "Unknown subcommand: '$SUBCOMMAND'. Run './swiftdeploy help'" ;;
esac