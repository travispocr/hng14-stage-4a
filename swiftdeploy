# SUBCOMMAND: audit
# =============================================================
cmd_audit() {
    info "Generating audit report from ${HISTORY_FILE}..."

    if [[ ! -f "$HISTORY_FILE" ]]; then
        die "No history file found. Run ./swiftdeploy deploy and ./swiftdeploy status first."
    fi

    python3 - "$HISTORY_FILE" "$AUDIT_REPORT" <<'PY'
import sys, json, re
from datetime import datetime

hist_file   = sys.argv[1]
report_file = sys.argv[2]

events = []
with open(hist_file) as f:
    for line in f:
        line = line.strip()
        if line:
            try:
                events.append(json.loads(line))
            except:
                pass

mode_changes  = [e for e in events if e.get("event") == "mode_change"]
chaos_events  = [e for e in events if "chaos" in str(e.get("data",""))]
violations    = [e for e in events if "blocked" in e.get("event","")]
policy_passes = [e for e in events if e.get("event") == "policy_pass"]
scrapes       = [e for e in events if e.get("event") == "status_scrape"]
deploys       = [e for e in events if e.get("event") in ("deploy_success","deploy_blocked")]

lines = []
lines.append("# SwiftDeploy Audit Report")
lines.append("")
lines.append(f"> Generated: {datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')}")
lines.append(f"> Source: `{hist_file}`")
lines.append(f"> Total events: {len(events)}")
lines.append("")

# ── Timeline ─────────────────────────────────────────────────
lines.append("## Timeline")
lines.append("")
lines.append("| Timestamp | Event | Detail |")
lines.append("|-----------|-------|--------|")

sig_events = [e for e in events if e.get("event") not in ("status_scrape",)]
for e in sig_events:
    ts     = e.get("timestamp","")
    event  = e.get("event","")
    data   = e.get("data",{})
    if isinstance(data, dict):
        detail = ", ".join(f"{k}={v}" for k,v in data.items())
    else:
        detail = str(data)
    lines.append(f"| `{ts}` | `{event}` | {detail} |")

lines.append("")

# ── Mode changes ──────────────────────────────────────────────
lines.append("## Mode Changes")
lines.append("")
if mode_changes:
    lines.append("| Timestamp | From | To |")
    lines.append("|-----------|------|----|")
    for e in mode_changes:
        ts   = e.get("timestamp","")
        data = e.get("data",{})
        lines.append(f"| `{ts}` | `{data.get('from','')}` | `{data.get('to','')}` |")
else:
    lines.append("_No mode changes recorded._")
lines.append("")

# ── Policy violations ─────────────────────────────────────────
lines.append("## Policy Violations")
lines.append("")
if violations:
    lines.append("| Timestamp | Event | Data |")
    lines.append("|-----------|-------|------|")
    for e in violations:
        ts   = e.get("timestamp","")
        evt  = e.get("event","")
        data = e.get("data",{})
        if isinstance(data, dict):
            detail = ", ".join(f"{k}={v}" for k,v in data.items())
        else:
            detail = str(data)
        lines.append(f"| `{ts}` | `{evt}` | {detail} |")
else:
    lines.append("_No policy violations recorded._")
lines.append("")

# ── Metrics summary ───────────────────────────────────────────
lines.append("## Metrics Summary")
lines.append("")
if scrapes:
    avg_rps     = sum(s["data"]["rps"] for s in scrapes) / len(scrapes)
    avg_err     = sum(s["data"]["error_rate_percent"] for s in scrapes) / len(scrapes)
    max_p99     = max(s["data"]["p99_latency_ms"] for s in scrapes)
    chaos_count = sum(1 for s in scrapes if s["data"]["chaos_active"] != 0)
    lines.append(f"| Metric | Value |")
    lines.append(f"|--------|-------|")
    lines.append(f"| Total scrapes | {len(scrapes)} |")
    lines.append(f"| Avg req/s | {avg_rps:.2f} |")
    lines.append(f"| Avg error rate | {avg_err:.4f}% |")
    lines.append(f"| Max P99 latency | {max_p99:.0f}ms |")
    lines.append(f"| Scrapes with chaos active | {chaos_count} |")
else:
    lines.append("_No metrics scrapes recorded._")
lines.append("")

lines.append("---")
lines.append("_Generated by swiftdeploy audit_")

with open(report_file, "w") as f:
    f.write("\n".join(lines) + "\n")

print(f"Report written to {report_file}")
print(f"  Events processed : {len(events)}")
print(f"  Mode changes     : {len(mode_changes)}")
print(f"  Policy violations: {len(violations)}")
print(f"  Metrics scrapes  : {len(scrapes)}")
PY

    success "Audit report generated: ${AUDIT_REPORT}"
}

# =============================================================
# SUBCOMMAND: teardown
# =============================================================
cmd_teardown() {
    local clean=false
    [[ "${1:-}" == "--clean" ]] && clean=true

    info "Tearing down the stack..."
    if [[ -f "$COMPOSE_OUT" ]]; then
        docker compose -f "$COMPOSE_OUT" down -v --remove-orphans 2>/dev/null || true
        success "Containers, networks, and volumes removed"
    else
        docker rm -f swiftdeploy-app swiftdeploy-nginx swiftdeploy-opa 2>/dev/null || true
        docker network rm swiftdeploy-net opa-internal 2>/dev/null || true
    fi

    if $clean; then
        rm -f "$NGINX_OUT" "$COMPOSE_OUT"
        success "Generated configs deleted"
    fi
    success "Teardown complete"
}

