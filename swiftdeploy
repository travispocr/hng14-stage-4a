    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo "  ./swiftdeploy <subcommand> [options]"
    echo ""
    echo -e "${BOLD}Subcommands:${NC}"
    echo "  init                      Generate nginx.conf + docker-compose.yml"
    echo "  validate                  Run 6 pre-flight checks"
    echo "  deploy                    Init, start stack, OPA gate, health check"
    echo "  promote [canary|stable]   Switch mode with OPA canary safety check"
    echo "  status                    Live metrics dashboard + history logging"
    echo "  audit                     Generate audit_report.md from history.jsonl"
    echo "  teardown [--clean]        Remove stack; --clean deletes generated files"
}

# =============================================================
# Entrypoint
# =============================================================
SUBCOMMAND="${1:-help}"
shift || true

case "$SUBCOMMAND" in
    init)     cmd_init ;;
    validate) cmd_validate ;;
    deploy)   cmd_deploy ;;
    promote)  cmd_promote "${1:-}" ;;
    status)   cmd_status ;;
    audit)    cmd_audit ;;
    teardown) cmd_teardown "${1:-}" ;;
    help|--help|-h) cmd_help ;;
    *) die "Unknown subcommand: '$SUBCOMMAND'. Run './swiftdeploy help'" ;;
esac