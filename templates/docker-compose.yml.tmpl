# Generated by swiftdeploy init — do not edit manually
# Source of truth: manifest.yaml

networks:
  {{NETWORK_NAME}}:
    driver: {{NETWORK_DRIVER}}

volumes:
  {{LOG_VOLUME}}:

services:

  app:
    image: {{SERVICE_IMAGE}}
    container_name: swiftdeploy-app
    restart: {{RESTART_POLICY}}
    environment:
      MODE: "{{MODE}}"
      APP_VERSION: "{{APP_VERSION}}"
      APP_PORT: "{{SERVICE_PORT}}"
    volumes:
      - {{LOG_VOLUME}}:/app/logs
    networks:
      - {{NETWORK_NAME}}
    # Never expose service port directly — all traffic via Nginx
    expose:
      - "{{SERVICE_PORT}}"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    read_only: false
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{SERVICE_PORT}}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 10s
    user: "appuser"

  nginx:
    image: {{NGINX_IMAGE}}
    container_name: swiftdeploy-nginx
    restart: {{RESTART_POLICY}}
    ports:
      - "{{NGINX_PORT}}:{{NGINX_PORT}}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
      - {{LOG_VOLUME}}:/var/log/nginx
    networks:
      - {{NETWORK_NAME}}
    depends_on:
      app:
        condition: service_healthy
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true